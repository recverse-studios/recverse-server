{
  "name": "recverse-server",
  "version": "2.0.0",
  "description": "RecVerse Server - Cloudflare Workers implementation for Rec Room private server (February 2023 build) with Layerbase PostgreSQL via Hyperdrive",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "migrate": "wrangler d1 execute recverse-db --file=migrations/001_core_tables.sql --local || echo \"D1 migration skipped, using Hyperdrive instead\""
  },
  "keywords": [
    "recroom",
    "private-server",
    "recverse",
    "recflare",
    "cloudflare-workers",
    "layerbase",
    "hyperdrive"
  ],
  "author": "RecVerse Team",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "hono": "^4.4.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "eslint": "^8.57.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.70.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "cloudflare": {
    "name": "recverse-server",
    "compatibility_date": "2026-11-27",
    "compatibility_flags": ["nodejs_compat"]
  }
}
